	author = {An, S. and Xu, H. and Zhong, J. and Li, X.},
	date = {2026},
	keywords = {A-stable, algorithm, Algorithms, Article, bioreactor, Bioreactors, cell culture, Cell culture, cell culture technique, Cell Culture Techniques, cell growth, comparative study, Computer software, control system, controlled study, Controllers, feedback system, flow rate, Fuzzy control, fuzzy logic, Fuzzy Logic, fuzzy {PID}, Fuzzy {PID} controller, Fuzzy-{PID}, human, Hydrogen-Ion Concentration, Interval type-2 fuzzy, interval type-2 fuzzy {PID}, Interval type-2 fuzzy {PID}, Microcontrollers, Molecular biology, oxygen consumption, {pH}, {pH} control, {PH} control, {pH} control systems, Ph level, process control, Proportional control systems, proportional integral derivative algorithm, reaction time, sensitivity analysis, steady state, {STM}32, Three term control systems, waste water management},
