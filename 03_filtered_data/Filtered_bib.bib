}

@article{de_souza_software_2024,
	title = {Software for classification of banana ripening stage using machine learning},
	volume = {46},
	issn = {01002945 (ISSN)},
	shorttitle = {Software para classificação do estado de maturação da banana utilizando aprendizado de máquina},
