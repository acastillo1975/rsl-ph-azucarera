	doi = {10.3390/s21155059},
	abstract = {The aim of this study is to establish the usefulness of an electronic tongue based on cyclic voltammetry e-tongue using five working electrodes (gold, silver, copper, platinum and glass) in honey adulteration detection. Authentic honey samples of different botanical origin (acacia, tilia, sunflower, polyfloral and raspberry) were adulterated with agave, maple, inverted sugar, corn and rice syrups in percentages of 5\%, 10\%, 20\% and 50\%. The silver and copper electrodes provided the clearest voltammograms, the differences between authentic and adulterated honey samples being highlighted by the maximum current intensity. The electronic tongue results have been correlated with physicochemical parameters (pH, free acidity, hydroxymethylfurfural content—5 HMF and electrical conductivity—EC). Using statistical methods such as Linear discriminant analysis (LDA) and Support vector machines (SVM), an accuracy of 94.87\% and 100\% respectively was obtained in the calibration step and 89.65\% and 100\% respectively in the validation step. The PLS-R (Partial Least Squares Regression) model (constructed from the minimum and maximum current intensity obtained for all electrodes) was used in physicochemical parameters prediction; EC reached the highest regression coefficients (0.840 in the calibration step and 0.842 in the validation step, respectively), being followed by pH (0.704 in the calibration step and 0.516 in the validation step, respectively). © 2021 by the authors. Licensee MDPI, Basel, Switzerland.},
	language = {English},
	number = {15},
	journal = {Sensors},
	publisher = {MDPI AG},
	author = {Ciursa, P. and Oroian, M.},
	year = {2021},
	keywords = {Support vector machines, Discriminant analysis, food contamination, Food Contamination, Calibration, Least squares approximations, Least-Squares Analysis, honey, Electrical conductivity, Honey, Food products, Discriminant Analysis, Copper, Electrodes, discriminant analysis, least square analysis, Detection, Partial least squares regression, Tongue, Cyclic voltammetry, Electronic tongues, Honey adulteration, Hydroxymethylfurfural, Linear discriminant analysis, Physicochemical parameters, Regression coefficient, Syrups, tongue, Voltammetric tongue, Working electrode},
